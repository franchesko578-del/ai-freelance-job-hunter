# --- Majburiy ---
BOT_TOKEN=
ADMIN_IDS=123456789

# --- Telegram akkaunt (Telethon) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Render'da kerak (fayl sessiya u yerda saqlanmaydi). Termux'da bo'sh qoldiring.
TELETHON_SESSION_STRING=

# --- AI (ixtiyoriy: none | openrouter | gemini) ---
AI_PROVIDER=openrouter
AI_API_KEY=
AI_MODEL=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Baza va tekshiruv ---
# Render persistent disk bilan: /var/data/jobs.db
DATABASE_PATH=data/jobs.db
# Daqiqada. 2 soat = 120. Render'da shu env asosiy (baza o'chsa ham saqlanadi)
SCAN_INTERVAL_MINUTES=120

# --- Ixtiyoriy sozlamalar (standart qiymatlar ko'rsatilgan) ---
MAX_MESSAGES_PER_SOURCE=60
# Shu soatdan eski postlar o'tkazib yuboriladi (0 = o'chirilgan)
MAX_AGE_HOURS=72
AI_CONCURRENCY=3
SCAN_ON_START=1
NOTIFY_ON_START=1
# Baza o'chib ketadigan hostingda manbalarni har ishga tushishda qayta qo'shadi:
# SEED_SOURCES=telegram @kanal;rss https://example.com/feed.xml
# Render Free uxlab qolmasligi uchun o'z URL'iga ping (0 = o'chirish)
KEEPALIVE=1
